# Copy this file to .env.local for local development.
# In Vercel: Project Settings -> Environment Variables (set for
# Production, Preview, and Development as appropriate).

# --- Database (Neon, via Vercel's Neon integration) ---
# Vercel's Neon integration sets this automatically when you add
# the integration to the project; only set it by hand for local dev
# against your own Neon branch.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- Vercel Blob ---
# Created automatically when you add the Blob store to your Vercel
# project; copy the token here for local dev.
BLOB_READ_WRITE_TOKEN=""

# --- Pusher Channels (real-time messaging) ---
# From your Pusher Channels app dashboard.
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER=""
